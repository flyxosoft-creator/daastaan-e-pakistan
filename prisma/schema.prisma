// This is your Prisma schema file for Daastaan-e-Pakistan
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PackageTier {
  CULTURAL
  FOOD
  FAMILY
  NATURE
}

enum PackageStatus {
  DRAFT
  PUBLISHED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentGateway {
  STRIPE
  SAFEPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum GuideStatus {
  PENDING
  VERIFIED
  ACTIVE
  SUSPENDED
}

enum PoliceStatus {
  PENDING
  CLEARED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum AdminRole {
  SUPER_ADMIN
  OPS_ADMIN
  CONTENT_MANAGER
}

enum CheckInType {
  TRIP_START
  PICKUP_DONE
  DAY_START
  DAY_COMPLETE
  TRIP_COMPLETE
}

enum SupportedCurrency {
  PKR
  USD
  GBP
}

// ─── User (Customer) ──────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  phone                 String?
  country               String?
  avatarUrl             String?
  emailVerified         Boolean   @default(false)
  emailVerifyToken      String?
  emailVerifyExpiry     DateTime?
  passwordHash          String?
  emergencyContactEnc   String?   // AES-256 encrypted JSON (FR-118)
  referralCode          String    @unique
  walletCreditPkr       Int       @default(0)
  loginAttempts         Int       @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime? // Soft delete (FR-044)

  // Relations
  accounts              Account[]
  bookings              Booking[]
  reviews               Review[]
  referralsMade         Referral[] @relation("ReferrerRelation")
  referralUsed          Referral?  @relation("RefereeRelation")
  newsletterSub         NewsletterSubscriber?
  sessions              Session[]
  auditLogs             AuditLog[]

  @@index([email])
  @@index([referralCode])
  @@map("users")
}

// ─── OAuth Accounts ───────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String  // "google" | "facebook" | "credentials"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ─── Session ──────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

// ─── Admin User ───────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole
  isActive     Boolean   @default(true)
  twoFaEnabled Boolean   @default(false)
  twoFaSecret  String?
  invitedBy    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]

  @@map("admin_users")
}

// ─── City ────────────────────────────────────────────────────────────────────

model City {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  heroImage      String
  introCopy      String    @db.Text
  seoTitle       String
  seoDescription String
  isActive       Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  packages       Package[]
  guides         Guide[]

  @@index([slug])
  @@index([isActive])
  @@map("cities")
}

// ─── Guide ───────────────────────────────────────────────────────────────────

model Guide {
  id              String       @id @default(cuid())
  name            String
  bio             String       @db.Text
  gender          Gender
  languages       String[]
  specialities    String[]
  avatarUrl       String
  rating          Float        @default(0)
  reviewCount     Int          @default(0)
  cnicEncrypted   String       // AES-256 encrypted
  policeStatus    PoliceStatus @default(PENDING)
  status          GuideStatus  @default(PENDING)
  cityId          String
  city            City         @relation(fields: [cityId], references: [id])
  isVerified      Boolean      @default(false)
  whatsappNumber  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  availabilities  GuideAvailability[]
  bookings        Booking[]

  @@index([cityId])
  @@index([status])
  @@index([gender])
  @@map("guides")
}

// ─── Guide Availability ───────────────────────────────────────────────────────

model GuideAvailability {
  id        String   @id @default(cuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  isBlocked Boolean  @default(false) // true = unavailable

  @@unique([guideId, date])
  @@index([guideId, date])
  @@map("guide_availabilities")
}

// ─── Package ──────────────────────────────────────────────────────────────────

model Package {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  tier           PackageTier
  cityId         String
  city           City          @relation(fields: [cityId], references: [id])
  durationHours  Int?          // for single-day packages
  durationDays   Int?          // for multi-day packages
  minParty       Int           @default(1)
  maxParty       Int           @default(12)
  basePricePkr   Int           // stored in PKR paisa (smallest unit)
  description    String        @db.Text
  included       String[]
  excluded       String[]
  itinerary      Json          // ItineraryDay[]
  images         String[]      // Cloudinary URLs
  isFeatured     Boolean       @default(false)
  status         PackageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  rating         Float         @default(0)
  reviewCount    Int           @default(0)
  bookingCount   Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  addOns         AddOn[]
  bookings       Booking[]
  reviews        Review[]

  @@index([cityId])
  @@index([tier])
  @@index([status])
  @@index([isFeatured])
  @@index([slug])
  @@map("packages")
}

// ─── Add-On ───────────────────────────────────────────────────────────────────

model AddOn {
  id          String   @id @default(cuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name        String
  description String
  pricePkr    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  bookingAddOns BookingAddOn[]

  @@map("add_ons")
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])
  packageId       String
  package         Package       @relation(fields: [packageId], references: [id])
  guideId         String
  guide           Guide         @relation(fields: [guideId], references: [id])
  startDate       DateTime
  endDate         DateTime
  partySize       Int
  status          BookingStatus @default(PENDING_PAYMENT)
  totalPkr        Int
  currency        SupportedCurrency
  chargedAmount   Int
  gateway         PaymentGateway
  paymentIntentId String?
  safetyLayerOn   Boolean       @default(false)
  pickupLocation  String?
  specialRequests String?       @db.VarChar(500)
  promoCodeId     String?
  promoCode       PromoCode?    @relation(fields: [promoCodeId], references: [id])
  internalNotes   String?       @db.Text
  slotHeldUntil   DateTime?     // FR-090: slot hold expiry
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment         Payment?
  addOns          BookingAddOn[]
  checkIns        GuideCheckIn[]
  sosEvents       SosEvent[]
  review          Review?
  locationUpdates TripLocation[]

  @@index([customerId])
  @@index([guideId])
  @@index([packageId])
  @@index([status])
  @@index([startDate])
  @@map("bookings")
}

// ─── Booking Add-On ───────────────────────────────────────────────────────────

model BookingAddOn {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId    String
  addOn      AddOn   @relation(fields: [addOnId], references: [id])
  pricePkr   Int     // snapshot at time of booking

  @@unique([bookingId, addOnId])
  @@map("booking_add_ons")
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])
  gateway           PaymentGateway
  gatewayPaymentId  String
  amountPkr         Int
  currency          SupportedCurrency
  chargedAmount     Int
  status            PaymentStatus @default(PENDING)
  webhookEvents     Json[]        // raw webhook payloads for audit
  refundedAt        DateTime?
  refundAmount      Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

// ─── Guide Check-In ───────────────────────────────────────────────────────────

model GuideCheckIn {
  id          String      @id @default(cuid())
  bookingId   String
  booking     Booking     @relation(fields: [bookingId], references: [id])
  type        CheckInType
  dayNumber   Int?        // for multi-day packages
  completedAt DateTime    @default(now())
  lat         Float?
  lng         Float?
  notes       String?

  @@index([bookingId])
  @@map("guide_check_ins")
}

// ─── Trip Location (Live Tracking) ────────────────────────────────────────────

model TripLocation {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  lat        Float
  lng        Float
  accuracy   Float?
  capturedAt DateTime @default(now())

  @@index([bookingId, capturedAt])
  @@map("trip_locations")
}

// ─── SOS Event ───────────────────────────────────────────────────────────────

model SosEvent {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  lat         Float
  lng         Float
  alertedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?   // adminUserId
  notes       String?

  @@index([bookingId])
  @@map("sos_events")
}

// ─── Review ───────────────────────────────────────────────────────────────────

model Review {
  id              String       @id @default(cuid())
  bookingId       String       @unique
  booking         Booking      @relation(fields: [bookingId], references: [id])
  customerId      String
  customer        User         @relation(fields: [customerId], references: [id])
  packageId       String
  package         Package      @relation(fields: [packageId], references: [id])
  rating          Int          // 1–5
  title           String?      @db.VarChar(80)
  body            String       @db.Text
  photos          String[]     // Cloudinary URLs
  status          ReviewStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([packageId, status])
  @@index([customerId])
  @@map("reviews")
}

// ─── Promo Code ───────────────────────────────────────────────────────────────

model PromoCode {
  id              String        @id @default(cuid())
  code            String        @unique
  discountType    DiscountType
  discountValue   Int           // percentage (0–100) or flat PKR amount
  minAmountPkr    Int?
  maxUses         Int?
  maxPerUser      Int           @default(1)
  usedCount       Int           @default(0)
  validFrom       DateTime
  validUntil      DateTime
  applicableTiers PackageTier[]
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  bookings        Booking[]
  usages          PromoUsage[]

  @@index([code])
  @@map("promo_codes")
}

model PromoUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  bookingId   String    @unique
  usedAt      DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@map("promo_usages")
}

// ─── Referral ─────────────────────────────────────────────────────────────────

model Referral {
  id            String    @id @default(cuid())
  referrerId    String
  referrer      User      @relation("ReferrerRelation", fields: [referrerId], references: [id])
  refereeId     String    @unique
  referee       User      @relation("RefereeRelation", fields: [refereeId], references: [id])
  creditEarnedPkr Int     @default(0)
  isCompleted   Boolean   @default(false) // true = referree completed first booking
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([referrerId])
  @@map("referrals")
}

// ─── Newsletter Subscriber ────────────────────────────────────────────────────

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  gdprConsent  Boolean  @default(false)
  isActive     Boolean  @default(true)
  unsubToken   String   @unique @default(cuid())
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([email])
  @@map("newsletter_subscribers")
}

// ─── Blog Post ────────────────────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  coverImage  String
  content     String   @db.Text // Markdown / Rich text
  category    String
  tags        String[]
  readTimeMin Int
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("blog_posts")
}

// ─── FAQ ─────────────────────────────────────────────────────────────────────

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(cuid())
  actorType   String    // "user" | "admin"
  actorId     String
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  action      String    // e.g. "profile.update", "booking.cancel"
  entityType  String?   // e.g. "Booking"
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

