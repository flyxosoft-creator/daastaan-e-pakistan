# Daastaan-e-Pakistan — API Environment Variables
# Copy this to .env.local and fill in real values

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://dep_user:dep_dev_password@localhost:5432/dep_db?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_secret_minimum_64_chars
ENCRYPTION_KEY=replace_with_64_char_hex_key_for_aes256_encryption

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=100

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Safepay ──────────────────────────────────────────────────────────────────
SAFEPAY_SECRET_KEY=your_safepay_secret
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret
SAFEPAY_BASE_URL=https://sandbox.api.getsafepay.com

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Daastaan-e-Pakistan <noreply@daastaan-e-pakistan.com>"

# ─── Twilio (SMS / SOS) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# ─── FX Rates ─────────────────────────────────────────────────────────────────
FX_API_URL=https://api.exchangerate-api.com/v4/latest/PKR
FX_API_KEY=

# ─── Referral ─────────────────────────────────────────────────────────────────
REFERRAL_CREDIT_PKR=50000

# ─── Client URLs ──────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

